{
	"name": "newspack-cache-cozy",
	"version": "0.4.1",
	"private": true,
	"description": "Refresh-ahead cache warmer for newspack-nodes.",
	"author": "Automattic",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "true",
		"release:archive": "./build-release.sh",
		"fix:php": "phpcbf",
		"fix:js": "true",
		"fix:scss": "true",
		"format": "true",
		"lint:php": "phpcs && php scripts/lint-comment-length.php .",
		"lint:js": "true && node scripts/lint-comment-length.mjs .",
		"lint:scss": "true",
		"lint:shell": "shellcheck scripts/pre-push scripts/*.sh",
		"lint:phpstan": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
		"test:js": "true",
		"test:js:coverage": "true"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^19.8.1",
		"lint-staged": "^15.5.2"
	},
	"lint-staged": {
		"*.php": [
			"./vendor/bin/phpcs",
			"sh -c 'npm run lint:phpstan --silent'",
			"php scripts/lint-comment-length.php"
		],
		"*.sh": "shellcheck",
		"scripts/pre-push": "shellcheck"
	}
}
